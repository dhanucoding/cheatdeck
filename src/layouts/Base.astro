---
import '../styles/global.css';
import Palette from '../components/Palette.tsx';
import Sidebar from '../components/Sidebar.astro';
import { allSheets, url } from '../lib';
const { title, description = 'Fast, keyboard-first cheat sheets for developers.', pagefind = false, current } = Astro.props;
const sheets = (await allSheets()).map((s) => ({ id: s.id, title: s.data.title, category: s.data.category, tags: s.data.tags, href: url(`/sheets/${s.id}/`) }));
const full = title === 'CheatDeck' ? title : `${title} · CheatDeck`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <button class="ghost browse" id="browse" aria-label="Browse sheets" aria-controls="sidebar">☰ Browse</button>
        <a class="brand" href={url('/')}>Cheat<b>Deck</b></a>
        <Palette client:load sheets={sheets} base={import.meta.env.BASE_URL.replace(/\/$/, '')} />
        <button class="ghost" id="theme" aria-label="Toggle theme">◐</button>
      </div>
    </header>
    <div class="shell">
      <Sidebar current={current} />
      <main data-pagefind-body={pagefind ? '' : undefined}><slot /></main>
    </div>
    <footer><div class="wrap">Built with Astro · hosted on GitHub Pages · <a href="https://github.com/DhanuCoding/cheatdeck">source</a></div></footer>
    <script is:inline>
      document.getElementById('theme').addEventListener('click', function () {
        var el = document.documentElement;
        var dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        el.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', el.dataset.theme); } catch (e) {}
      });
    </script>
    <script is:inline>
      (function () {
        var b = document.body, close = function () { b.classList.remove('nav-open'); };
        document.getElementById('browse').addEventListener('click', function () { b.classList.toggle('nav-open'); });
        document.getElementById('scrim').addEventListener('click', close);
        document.getElementById('sidebar').addEventListener('click', function (e) { if (e.target.closest('a')) close(); });
        addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        var cur = document.querySelector('.sidebar a[aria-current]');
        if (cur) cur.scrollIntoView({ block: 'nearest' });
      })();
    </script>
  </body>
</html>
