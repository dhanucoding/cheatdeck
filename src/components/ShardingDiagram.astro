<figure class="diagram">
  <svg viewBox="0 0 640 190" role="img" aria-label="Sharding: a client request reaches a router that hashes the shard key and sends it to one of three shards, each with replicas">
    <defs>
      <marker id="sd-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="dg-ah" /></marker>
    </defs>
    <rect class="dg-node" x="10" y="66" width="100" height="40" rx="8" /><text class="dg-t" x="60" y="91" text-anchor="middle">Client</text>
    <rect class="dg-hot" x="190" y="60" width="130" height="52" rx="10" />
    <text class="dg-hot-t" x="255" y="82" text-anchor="middle">Router</text>
    <text class="dg-hot-t" x="255" y="99" text-anchor="middle" style="font-size:10.5px;font-weight:500">hash(user_id) % 3</text>

    <rect class="dg-node" x="400" y="6" width="120" height="46" rx="8" /><text class="dg-t" x="460" y="26" text-anchor="middle">Shard 0</text><text class="dg-s" x="460" y="42" text-anchor="middle">hash % 3 = 0</text>
    <rect class="dg-node" x="400" y="62" width="120" height="46" rx="8" /><text class="dg-t" x="460" y="82" text-anchor="middle">Shard 1</text><text class="dg-s" x="460" y="98" text-anchor="middle">hash % 3 = 1</text>
    <rect class="dg-node" x="400" y="118" width="120" height="46" rx="8" /><text class="dg-t" x="460" y="138" text-anchor="middle">Shard 2</text><text class="dg-s" x="460" y="154" text-anchor="middle">hash % 3 = 2</text>
    <text class="dg-s" x="530" y="33">+ replicas</text>
    <text class="dg-s" x="530" y="89">+ replicas</text>
    <text class="dg-s" x="530" y="145">+ replicas</text>

    <line class="dg-e" x1="110" y1="86" x2="188" y2="86" marker-end="url(#sd-a)" />
    <line class="dg-e" x1="320" y1="76" x2="398" y2="32" marker-end="url(#sd-a)" />
    <line class="dg-e" x1="320" y1="86" x2="398" y2="86" marker-end="url(#sd-a)" />
    <line class="dg-e" x1="320" y1="96" x2="398" y2="140" marker-end="url(#sd-a)" />
    <text class="dg-s" x="320" y="184" text-anchor="middle">Each key lives on exactly one shard. Each shard is replicated for availability.</text>
  </svg>
</figure>
