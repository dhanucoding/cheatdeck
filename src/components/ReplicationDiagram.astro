<figure class="diagram">
  <svg viewBox="0 0 640 150" role="img" aria-label="Leader-follower replication: a writer app writes to the leader, which replicates asynchronously to two followers that serve reads">
    <defs>
      <marker id="rd-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="dg-ah" /></marker>
      <marker id="rd-b" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="dg-aha" /></marker>
    </defs>
    <rect class="dg-node" x="10" y="40" width="100" height="40" rx="8" /><text class="dg-t" x="60" y="65" text-anchor="middle">Writer app</text>
    <rect class="dg-hot" x="170" y="40" width="110" height="40" rx="8" /><text class="dg-hot-t" x="225" y="65" text-anchor="middle">Leader</text>
    <rect class="dg-node" x="350" y="8" width="110" height="40" rx="8" /><text class="dg-t" x="405" y="33" text-anchor="middle">Follower 1</text>
    <rect class="dg-node" x="350" y="72" width="110" height="40" rx="8" /><text class="dg-t" x="405" y="97" text-anchor="middle">Follower 2</text>
    <rect class="dg-node" x="520" y="40" width="110" height="40" rx="8" /><text class="dg-t" x="575" y="65" text-anchor="middle">Reader apps</text>

    <line class="dg-e" x1="110" y1="60" x2="168" y2="60" marker-end="url(#rd-a)" />
    <line class="dg-ea" x1="280" y1="56" x2="348" y2="30" marker-end="url(#rd-b)" />
    <line class="dg-ea" x1="280" y1="64" x2="348" y2="90" marker-end="url(#rd-b)" />
    <line class="dg-e" x1="460" y1="30" x2="518" y2="54" marker-end="url(#rd-a)" />
    <line class="dg-e" x1="460" y1="90" x2="518" y2="66" marker-end="url(#rd-a)" />

    <text class="dg-s" x="140" y="52" text-anchor="middle">writes</text>
    <text class="dg-s" x="316" y="64" text-anchor="middle">async copy</text>
    <text class="dg-s" x="490" y="64" text-anchor="middle">reads</text>
    <text class="dg-s" x="320" y="140" text-anchor="middle">Followers may lag the leader, so a read can briefly return stale data.</text>
  </svg>
</figure>
