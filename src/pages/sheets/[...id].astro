---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PinButton from '../../components/PinButton.tsx';
import { allSheets, catalog, CATEGORIES, url } from '../../lib';

export async function getStaticPaths() {
  const sheets = await allSheets();
  return sheets.map((s) => ({ params: { id: s.id }, props: { sheet: s, all: sheets } }));
}
const { sheet, all } = Astro.props;
const { Content, headings } = await render(sheet);
const d = sheet.data;
const related = d.related.map((id) => all.find((s) => s.id === id)).filter(Boolean);
const toc = headings.filter((h) => h.depth === 2);
const flat = (await catalog()).find((c) => c.key === d.category)?.flat ?? [];
const i = flat.findIndex((s) => s.id === sheet.id);
const prev = i > 0 ? flat[i - 1] : undefined;
const next = i >= 0 && i < flat.length - 1 ? flat[i + 1] : undefined;
---
<Base title={d.title} description={d.summary} pagefind current={sheet.id}>
  <div class="sheet-layout">
    <article class="sheet" data-sheet-id={sheet.id}>
      <div class="crumb"><a href={url('/')}>home</a> / {CATEGORIES[d.category]?.label ?? d.category} / {d.topic}</div>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="meta">{d.tags.map((t) => <span class="pill">{t}</span>)}<span class="pill">{d.difficulty}</span><PinButton client:load id={sheet.id} /></div>
      {toc.length > 1 && (
        <details class="jump">
          <summary>Jump to</summary>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>
      )}
      <Content />
      {related.length > 0 && (
        <>
          <h2>Related</h2>
          <div class="related">{related.map((r) => <a href={url(`/sheets/${r!.id}/`)}>{r!.data.title}</a>)}</div>
        </>
      )}
      {(prev || next) && (
        <nav class="pn" aria-label="Previous and next sheet">
          {prev ? <a href={url(`/sheets/${prev.id}/`)}><small>← Previous</small><span>{prev.data.title}</span></a> : <span />}
          {next ? <a class="r" href={url(`/sheets/${next.id}/`)}><small>Next →</small><span>{next.data.title}</span></a> : <span />}
        </nav>
      )}
    </article>
    {toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <h4>On this page</h4>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`} data-id={h.slug}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>
  <script>
    import { markViewed } from '../../store';
    const id = document.querySelector<HTMLElement>('article.sheet')?.dataset.sheetId;
    if (id) setTimeout(() => markViewed(id), 4000);
  </script>
  <script is:inline>
    (function () {
      var links = [].slice.call(document.querySelectorAll('.toc a'));
      if (!links.length || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (l) { l.classList.toggle('on', l.dataset.id === e.target.id); });
        });
      }, { rootMargin: '-72px 0px -70% 0px' });
      links.forEach(function (l) { var h = document.getElementById(l.dataset.id); if (h) io.observe(h); });
    })();
  </script>
</Base>
