---
import Base from '../layouts/Base.astro';
import { catalog, url } from '../lib';
const cats = await catalog();
---
<Base title="Page not found" description="That page does not exist." noindex>
  <section class="hero">
    <p class="crumb">404</p>
    <h1>That sheet isn't here.</h1>
    <p>The link may be old or mistyped. Try search (<kbd>⌘K</kbd>), the menu, or one of these.</p>
  </section>
  <div class="grid">
    {cats.map((c) => (
      <a class="card" href={url(`/sheets/${c.flat[0].id}/`)}>
        <h3>{c.icon} {c.label}</h3>
        <p>{c.blurb}</p>
        <span class="pill">{c.flat.length} {c.flat.length === 1 ? 'sheet' : 'sheets'}</span>
      </a>
    ))}
    <a class="card" href={url('/')}>
      <h3>← Home</h3>
      <p>Back to all sheets.</p>
    </a>
  </div>
</Base>
