---
import Base from '../layouts/Base.astro';
import YourStuff from '../components/YourStuff.tsx';
import { catalog, allSheets, url } from '../lib';
const cats = await catalog();
const featured = (await allSheets()).filter((s) => s.data.featured);
const lite = (await allSheets()).map((s) => ({ id: s.id, title: s.data.title, summary: s.data.summary, href: url(`/sheets/${s.id}/`), difficulty: s.data.difficulty }));
const total = cats.reduce((n, c) => n + c.flat.length, 0);
---
<Base title="CheatDeck">
  <section class="hero">
    <h1>Cheat sheets you can<br />actually skim.</h1>
    <p>{total} short, opinionated cards. Browse on the left, or press <kbd>⌘K</kbd> to jump anywhere.</p>
  </section>

  <YourStuff client:load sheets={lite} />

  <h2 class="section">Start here</h2>
  <div class="grid">
    {featured.map((s) => (
      <a class="card" href={url(`/sheets/${s.id}/`)}>
        <h3>{s.data.title}</h3>
        <p>{s.data.summary}</p>
        <span class="pill">{s.data.difficulty}</span>
      </a>
    ))}
  </div>

  {cats.map((c) => (
    <section class="catalog">
      <h2 class="section">{c.icon} {c.label}<small>{c.blurb}</small></h2>
      {c.topics.map((t) => (
        <div class="topic">
          <h3>{t.name}</h3>
          <div class="rows">
            {t.items.map((s) => (
              <a class="row" href={url(`/sheets/${s.id}/`)}>
                <span class={`dot ${s.data.difficulty}`} title={s.data.difficulty}></span>
                <strong>{s.data.title}</strong>
                <span class="sum">{s.data.summary}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}
</Base>
